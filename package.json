{
  "name": "crucible",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "lint": "biome lint --write . && eslint --fix src/",
    "eslint": "eslint --fix src/",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "types": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "latest",
    "@types/react": "19.1.2",
    "eslint": "10.0.3",
    "husky": "9.1.7",
    "lint-staged": "16.3.2",
    "typescript-eslint": "8.56.1"
  },
  "peerDependencies": {
    "typescript": "5"
  },
  "dependencies": {
    "commander": "14.0.3",
    "ink": "6.8.0",
    "react": "19.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": "biome check --write --no-errors-on-unmatched",
    "*.{ts,tsx}": "eslint --fix"
  }
}
